{
  "name": "kinoboxd",
  "version": "1.0.0",
  "private": true,
  "description": "Personal media statistics backend for films (KinoPoisk, TMDB, Letterboxd), books (LiveLib, Hardcover) and games (Steam, GOG, Epic)",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "backfill:keywords": "node server/backfill.js keywords",
    "backfill:imdb": "node server/backfill.js imdb",
    "backfill:collections": "node server/backfill.js collections",
    "backfill:wikidata": "node server/backfill.js wikidata",
    "backfill:mcu": "node server/backfill.js mcu",
    "rematch": "node server/backfill.js rematch",
    "backfill:manga": "node server/books/manga-backfill.js",
    "backfill:years": "node server/books/years-backfill.js",
    "backfill:authors": "node server/books/authors-backfill.js",
    "gen:contracts": "node scripts/gen-contracts.js",
    "census": "node scripts/census.js",
    "quality:books": "node scripts/books-quality.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cheerio": "^1.2.0",
    "express": "^4.21.2",
    "multer": "^2.4.0"
  }
}
